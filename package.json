{
  "name": "dsh-session-memory",
  "version": "1.0.0",
  "description": "DSH 单会话记忆 + 情绪插件：每个会话各自记住事实、偏好、人物卡，并带一套会变的情绪与会长出来的性格；本地落盘，可在会话顶部工具栏开关、编辑、导出。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "memory",
    "session",
    "character-card",
    "emotion",
    "mood",
    "personality",
    "记忆",
    "人物卡"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "meta": {
    "title": "单会话记忆 + 情绪",
    "description": "每个会话独立记住事实与人物卡，外加多维情绪和会长的性格标签；本地落盘；顶部工具栏可开关、增删、导出。"
  }
}
